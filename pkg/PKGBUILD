# Maintainer: Augusto Coronel <aocoronel at proton dot me>
pkgname=pacmirror
pkgver=0.0.0
pkgrel=1
pkgdesc="Declarative package management for Arch-based Linux"
arch=('any')
url="https://codeberg.org/aocoronel/aoclibs/"
license=('MIT')
depends=()
optdepends=()
conflicts=('pacmirror')
provides=('pacmirror')
makedepends=(gcc)
source=("https://github.com/aocoronel/pacmirror-config/archive/refs/heads/main.zip")
sha256sums=('SKIP')

build() {
  cd pacmirror-config-main

  CFLAGS=("-Wall" "-Wextra")
  gcc -o setup setup.c "${CFLAGS[@]}" && ./setup
}

package() {
  cd pacmirror-config-main
  install -Dm755 pacmirror "${pkgdir}/usr/bin/pacmirror"
}
